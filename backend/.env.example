# Database (local dev uses docker-compose postgres)
DATABASE_URL=postgresql+asyncpg://jobhunt:jobhunt_dev@localhost:5432/jobhunt

# Supabase (for production / auth / storage)
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_ANON_KEY=eyJ...

# External APIs
JSEARCH_RAPIDAPI_KEY=
FIRECRAWL_API_KEY=
ANTHROPIC_API_KEY=

# App config
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
# Required to call /api/v1/cron/* (send "Authorization: Bearer <value>")
CRON_SECRET=
