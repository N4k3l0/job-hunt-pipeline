# Database (local dev uses docker-compose postgres)
DATABASE_URL=postgresql+asyncpg://jobhunt:jobhunt_dev@localhost:5432/jobhunt

# Supabase (for production / auth / storage)
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_ANON_KEY=eyJ...

# Redis
REDIS_URL=redis://localhost:6379/0

# External APIs
APIFY_API_TOKEN=
APIFY_WEBHOOK_SECRET=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JSEARCH_RAPIDAPI_KEY=
FIRECRAWL_API_KEY=
