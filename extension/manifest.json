{
  "manifest_version": 3,
  "name": "Job Hunt: Apply for me",
  "short_name": "Job Hunt",
  "version": "0.1.0",
  "description": "Fills in job applications on Greenhouse, Lever and Ashby with the answers you approved in Job Hunt. You press Submit.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://backend-production-7e805.up.railway.app/*",
    "http://localhost:8000/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://jobhuntpipeline.vercel.app/*", "http://localhost:3000/*"],
      "js": ["app-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://job-boards.greenhouse.io/*",
        "https://job-boards.eu.greenhouse.io/*",
        "https://boards.greenhouse.io/*",
        "https://boards.eu.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.eu.lever.co/*",
        "https://jobs.ashbyhq.com/*"
      ],
      "js": ["fill.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://job-boards.greenhouse.io/*",
        "https://job-boards.eu.greenhouse.io/*",
        "https://boards.greenhouse.io/*",
        "https://boards.eu.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.eu.lever.co/*",
        "https://jobs.ashbyhq.com/*"
      ],
      "js": ["form-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
